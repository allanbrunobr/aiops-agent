# AIOps Agent — Variaveis de ambiente para teste local
# Copie para .env.local e preencha os valores:
#   cp env.example .env.local
#
# Documentacao completa: infra/README.md

# Token de autenticacao do webhook Grafana -> AIOps Agent
# Deve bater com o configurado em infra/grafana/provisioning/alerting/contact-points.yaml
GRAFANA_WEBHOOK_TOKEN=test-grafana-token-local

# Slack Bot Token — obtenha criando um Slack App:
#   1. https://api.slack.com/apps -> Create New App -> From scratch
#   2. OAuth & Permissions -> Bot Token Scopes -> chat:write, chat:write.public
#   3. Install to Workspace -> copie o Bot User OAuth Token (xoxb-...)
# Deixe vazio para modo sem Slack (diagnostico salvo em output/fallback_*.json)
SLACK_BOT_TOKEN=

# Canal do Slack onde as notificacoes serao enviadas
SLACK_CHANNEL=#aiops-alerts
