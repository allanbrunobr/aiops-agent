# AIOps Agent - Analysis Thresholds Configuration
#
# Copy this file to aiops.toml to customize thresholds:
#   cp aiops.toml.example aiops.toml
#
# Or specify a custom path:
#   python main.py --config /path/to/custom.toml
#
# All values below are the defaults — omit any you don't need to change.
# The pipeline auto-discovers aiops.toml in the project root.

[thresholds]

# --- Anomaly Detection (MetricFilter) ---

# Standard deviations above baseline mean to flag as anomaly
# Higher = fewer anomalies detected (less sensitive)
# Lower = more anomalies detected (more sensitive)
sigma_threshold = 3.0

# Fraction of time series used as pre-incident baseline (0.0-1.0)
# 0.5 = first half is baseline, second half is analyzed
baseline_ratio = 0.5

# --- Trace Filtering (TraceFilter) ---

# Percentile threshold for "slow" traces (0-100)
# 95.0 = traces above the 95th percentile are flagged
percentile_threshold = 95.0

# Maximum hop depth for slow trace call path extraction
# 3 = show up to 3 services in the call chain
max_hops = 3

# --- TNR Safety (TNRSafetyGuard) ---

# Maximum health score drop before triggering rollback (must be <= 0)
# -5.0 per STRATUS paper (NeurIPS 2025, UIUC + IBM Research):
# "up to 5 points of health score decrease is tolerated to avoid
# false-positive rollbacks from metric jitter"
regression_threshold = -5.0

# --- Incident Detection (DetectionAgent) ---

# Minimum error count to trigger incident detection
error_threshold = 50

# Sigma threshold for high-severity anomaly classification in detection
# (separate from MetricFilter sigma — controls detection sensitivity)
detection_sigma_threshold = 3.0
