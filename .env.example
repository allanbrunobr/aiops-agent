# AIOps Agent - Environment Variables
#
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Anthropic (required for LLM-based diagnosis) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- LLM Model (optional, default: claude-sonnet-4-20250514) ---
# AIOPS_LLM_MODEL=claude-sonnet-4-20250514

# --- Databricks (required only for --data-source databricks) ---
# DATABRICKS_HOST=https://your-workspace.databricks.com
# DATABRICKS_TOKEN=dapi_your_token_here
# DATABRICKS_WAREHOUSE_ID=your_warehouse_id

# --- Local lab (Grafana webhook and Slack) ---
# Public lab token. It matches infra/grafana provisioning. Do not reuse it.
GRAFANA_WEBHOOK_TOKEN=test-grafana-token-local

# Leave empty to skip Slack. Diagnosis is written under output/fallback_*.json
SLACK_BOT_TOKEN=

SLACK_CHANNEL=#aiops-alerts

# --- Demo server security (interfaces/demo/server.py) ---
# When set, mutation endpoints (start/stop/reset/compare/speed) require the
# header "X-Demo-Token: <value>". Unset = open dev mode (localhost only!).
# AIOPS_DEMO_TOKEN=change-me
# Real Slack sends from the demo require BOTH SLACK_BOT_TOKEN and this opt-in;
# default is dry-run (log only).
# AIOPS_DEMO_SLACK_REAL=0

# --- Webhook server (infra/run_webhook_server.py) ---
# Real Slack sends require BOTH SLACK_BOT_TOKEN and this opt-in; default dry-run.
# AIOPS_WEBHOOK_SLACK_REAL=0
# Point the Slack client at the local mock (infra/slack-mock) instead of slack.com
# SLACK_API_BASE_URL=http://localhost:47892/api
