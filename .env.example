# AIOps Agent - Environment Variables
#
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Anthropic (required for LLM-based diagnosis) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- LLM Model (optional, default: claude-sonnet-4-20250514) ---
# AIOPS_LLM_MODEL=claude-sonnet-4-20250514

# --- Databricks (required only for --data-source databricks) ---
# DATABRICKS_HOST=https://your-workspace.databricks.com
# DATABRICKS_TOKEN=dapi_your_token_here
# DATABRICKS_WAREHOUSE_ID=your_warehouse_id

# --- Local lab (Grafana webhook and Slack) ---
# Public lab token. It matches infra/grafana provisioning. Do not reuse it.
GRAFANA_WEBHOOK_TOKEN=test-grafana-token-local

# Leave empty to skip Slack. Diagnosis is written under output/fallback_*.json
SLACK_BOT_TOKEN=

SLACK_CHANNEL=#aiops-alerts
